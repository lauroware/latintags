<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Panel Superadmin | Tags Inteligentes</title>
    <style>
        :root {
            --bg: #0b0f14;
            --panel: rgba(255,255,255,0.06);
            --border: rgba(255,255,255,0.12);
            --text: rgba(255,255,255,0.92);
            --muted: rgba(255,255,255,0.55);
            --accent: #00a7c4;
            --danger: #e05555;
            --success: #2ecc7a;
            --radius: 14px;
        }
        body { background: #0b0f14; color: var(--text); font-family: Inter, system-ui, sans-serif; margin: 0; }
        .sa-wrapper { max-width: 1200px; margin: 0 auto; padding: 32px 20px 60px; }
        .sa-header { display: flex; align-items: center; gap: 14px; margin-bottom: 36px; flex-wrap: wrap; }
        .sa-badge { background: var(--accent); color: #000; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; letter-spacing: .06em; text-transform: uppercase; }
        .sa-header h1 { font-size: 22px; font-weight: 600; margin: 0; }
        .sa-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
        @media(max-width: 800px) { .sa-grid { grid-template-columns: 1fr; } }
        .sa-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; backdrop-filter: blur(2px); }
        .sa-card h2 { font-size: 15px; font-weight: 600; margin: 0 0 22px; color: var(--accent); letter-spacing: .04em; text-transform: uppercase; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
        .sa-section-label { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 20px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
        .sa-field { margin-bottom: 14px; }
        .sa-field label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 5px; }
        .sa-field input, .sa-field select { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 8px; padding: 9px 12px; color: var(--text); font-size: 14px; transition: border-color .2s; }
        .sa-field input:focus, .sa-field select:focus { outline: none; border-color: var(--accent); }
        .sa-field select option { background: #1a1f28; }
        .sa-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: end; }
        .next-tag-btn { background: rgba(0,167,196,0.2); border: 1px solid var(--accent); color: var(--accent); border-radius: 8px; padding: 9px 14px; font-size: 13px; font-weight: 500; cursor: pointer; transition: 0.2s; white-space: nowrap; }
        .next-tag-btn:hover { background: rgba(0,167,196,0.4); }
        .sa-btn-create { width: 100%; margin-top: 20px; padding: 12px; background: var(--accent); color: #000; font-weight: 700; font-size: 15px; border: none; border-radius: 10px; cursor: pointer; transition: opacity .2s; }
        .sa-btn-create:hover { opacity: .85; }
        .sa-btn-create:disabled { opacity: .4; cursor: not-allowed; }
        .filter-bar { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; background: rgba(255,255,255,0.03); padding: 8px 12px; border-radius: 40px; }
        .filter-btn { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 6px 16px; border-radius: 40px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .filter-btn.active { background: var(--accent); border-color: var(--accent); color: #000; }
        .filter-btn:hover:not(.active) { background: rgba(255,255,255,0.1); color: var(--text); }
        .sa-table-wrap { overflow-x: auto; border-radius: 12px; margin-top: 10px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 12px; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); }
        td { padding: 11px 12px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        .badge-role { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge-pet, .badge-admin { background: rgba(0,167,196,.2); color: var(--accent); }
        .badge-object, .badge-admin1 { background: rgba(240,160,60,.2); color: #f0a03c; }
        .badge-person, .badge-admin2 { background: rgba(46,204,122,.2); color: #2ecc7a; }
        .badge-user { background: rgba(255,255,255,.1); color: var(--muted); }
        .btn-del { background: transparent; border: 1px solid var(--danger); color: var(--danger); border-radius: 7px; padding: 4px 10px; font-size: 12px; cursor: pointer; transition: background .2s; margin-right: 6px; }
        .btn-del:hover { background: rgba(224,85,85,.15); }
        .btn-qr { display: inline-block; padding: 4px 10px; border: 1px solid var(--accent); color: var(--accent); border-radius: 7px; font-size: 12px; text-decoration: none; }
        .no-profile { color: var(--muted); font-style: italic; }
        .pagination { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
        .pagination button { background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--text); padding: 6px 14px; border-radius: 8px; font-size: 13px; cursor: pointer; transition: 0.2s; }
        .pagination button:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); color: #000; }
        .pagination button:disabled { opacity: 0.3; cursor: not-allowed; }
        .pagination .active-page { background: var(--accent); color: #000; border-color: var(--accent); font-weight: bold; }
        #sa-feedback { display: none; margin-top: 16px; padding: 12px 16px; border-radius: 10px; font-size: 14px; font-weight: 500; }
        #sa-feedback.ok  { background: rgba(46,204,122,.15); border: 1px solid rgba(46,204,122,.35); color: var(--success); display: block; }
        #sa-feedback.err { background: rgba(224,85,85,.15); border: 1px solid rgba(224,85,85,.35); color: var(--danger); display: block; }
        .counter-badge { background: rgba(0,167,196,0.2); padding: 2px 10px; border-radius: 30px; font-size: 12px; }
        /* Navbar */
        .sa-nav { background: rgba(0,0,0,0.4); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: flex-end; }
        .sa-nav a { color: rgba(255,255,255,0.7); font-size: 0.85rem; text-decoration: none; }
        .sa-nav a:hover { color: #fff; }
    </style>
</head>
<body>
<nav class="sa-nav">
    <a href="/auth/logout">Cerrar sesión</a>
</nav>
<div class="sa-wrapper">
    <div class="sa-header">
        <span class="sa-badge">Superadmin</span>
        <h1>Panel de administración de tags</h1>
    </div>

    <div class="sa-grid">
        <div class="sa-card">
            <h2>Crear nuevo tag</h2>
            <div class="sa-section-label">Tipo de perfil</div>
            <div class="sa-field">
                <label for="profileType">Tipo *</label>
                <select id="profileType">
                    <option value="">— Seleccioná un tipo —</option>
                    <option value="pet">🐾 Mascota</option>
                    <option value="object">📦 Objeto</option>
                    <option value="person">👤 Persona</option>
                </select>
            </div>
            <div class="sa-section-label">Acceso</div>
            <div class="sa-row">
                <div class="sa-field" style="flex:1">
                    <label>Número de tag *</label>
                    <input type="text" id="tag" placeholder="ej: 10042" />
                </div>
                <div>
                    <button type="button" class="next-tag-btn" id="nextTagBtn">✨ Siguiente disponible</button>
                </div>
            </div>
            <div class="sa-field">
                <label>Contraseña *</label>
                <input type="password" id="password" placeholder="Mínimo 6 caracteres" />
            </div>
            <input type="hidden" id="role" />
            <p style="font-size:13px;color:var(--muted);margin:16px 0 0">El usuario completa su nombre, foto y datos al ingresar.</p>
            <div id="sa-feedback"></div>
            <button class="sa-btn-create" id="btnCreate">Crear tag</button>
        </div>

        <div class="sa-card">
            <h2>Tags existentes <span class="counter-badge" id="totalCount">0</span></h2>
            <div class="filter-bar">
                <button data-filter="all" class="filter-btn active">Todos</button>
                <button data-filter="pet" class="filter-btn">🐾 Mascotas</button>
                <button data-filter="object" class="filter-btn">📦 Objetos</button>
                <button data-filter="person" class="filter-btn">👤 Personas</button>
            </div>
            <div class="sa-table-wrap">
                <table>
                    <thead><tr><th>Tag</th><th>Nombre</th><th>Tipo</th><th>Perfil</th><th>Acciones</th></tr></thead>
                    <tbody id="usersTableBody">
                        <tr><td colspan="5" style="text-align:center;padding:40px">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="pagination" id="paginationControls"></div>
        </div>
    </div>
</div>

<script>
    const ROLE_MAP = { pet: 'admin', object: 'admin1', person: 'admin2' };
    const PROFILE_LABEL = { pet: 'Mascota', admin: 'Mascota', admin1: 'Objeto', admin2: 'Persona', object: 'Objeto', person: 'Persona' };
    const ITEMS_PER_PAGE = 8;
    let allUsers = [], currentFilter = 'all', currentPage = 1;

    const tbody = document.getElementById('usersTableBody');
    const paginationDiv = document.getElementById('paginationControls');
    const totalCountSpan = document.getElementById('totalCount');
    const profileTypeSelect = document.getElementById('profileType');
    const tagInput = document.getElementById('tag');
    const passwordInput = document.getElementById('password');
    const roleHidden = document.getElementById('role');
    const btnCreate = document.getElementById('btnCreate');
    const nextTagBtn = document.getElementById('nextTagBtn');
    const feedbackDiv = document.getElementById('sa-feedback');

    function showFeedback(msg, isError) {
        feedbackDiv.textContent = msg;
        feedbackDiv.className = isError ? 'err' : 'ok';
        setTimeout(() => { feedbackDiv.style.display = 'none'; feedbackDiv.className = ''; }, 4000);
    }

    async function fetchAllUsers() {
        try {
            const res = await fetch('/superadmin/users');
            if (!res.ok) throw new Error();
            const data = await res.json();
            allUsers = (data.users || []).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            applyFiltersAndRender();
        } catch {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--danger)">Error cargando datos.</td></tr>';
        }
    }

    function getNextAvailableTag() {
        if (!allUsers.length) return "1";
        const tags = allUsers.map(u => parseInt(u.tag, 10)).filter(n => !isNaN(n));
        if (!tags.length) return "1";
        const usedSet = new Set(tags);
        const max = Math.max(...tags);
        for (let i = 1; i <= max + 1; i++) { if (!usedSet.has(i)) return i.toString(); }
        return (max + 1).toString();
    }

    function fillNextTag() {
        const next = getNextAvailableTag();
        tagInput.value = next;
        showFeedback(`📌 Siguiente número sugerido: ${next}`, false);
    }

    function applyFiltersAndRender() {
        let filtered = [...allUsers];
        if (currentFilter !== 'all') filtered = filtered.filter(u => u.profileType === currentFilter);
        const total = filtered.length;
        totalCountSpan.innerText = total;
        const totalPages = Math.ceil(total / ITEMS_PER_PAGE) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;
        renderTableBody(filtered.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE));
        renderPagination(totalPages, currentPage);
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m]));
    }

    function renderTableBody(users) {
        if (!users.length) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:40px;color:var(--muted)">Sin resultados</td></tr>'; return; }
        tbody.innerHTML = users.map(user => {
            const role = user.role || ROLE_MAP[user.profileType] || 'user';
            const label = PROFILE_LABEL[role] || role;
            const badgeClass = role === 'admin' ? 'badge-admin' : role === 'admin1' ? 'badge-admin1' : role === 'admin2' ? 'badge-admin2' : 'badge-user';
            const name = [user.first_name, user.last_name].filter(Boolean).join(' ') || '—';
            const profileTitle = user.profile?.title || '';
            const qr = user.profile?._id ? `<a href="/qr/${user.profile._id}" class="btn-qr" download>QR</a>` : '';
            return `<tr id="row-${user.tag}">
                <td><strong>#${escapeHtml(user.tag)}</strong></td>
                <td style="color:var(--muted)">${escapeHtml(name)}</td>
                <td><span class="badge-role ${badgeClass}">${escapeHtml(label)}</span></td>
                <td>${profileTitle ? escapeHtml(profileTitle) : '<span class="no-profile">Sin completar</span>'}</td>
                <td><button class="btn-del" data-tag="${user.tag}">Eliminar</button>${qr}</td>
            </tr>`;
        }).join('');
        document.querySelectorAll('.btn-del').forEach(btn => {
            btn.addEventListener('click', () => eliminarTag(btn.getAttribute('data-tag'), btn));
        });
    }

    function renderPagination(totalPages, activePage) {
        if (totalPages <= 1) { paginationDiv.innerHTML = ''; return; }
        let html = `<button class="page-prev" ${activePage === 1 ? 'disabled' : ''}>‹ Anterior</button>`;
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= activePage - 1 && i <= activePage + 1))
                html += `<button class="page-num ${i === activePage ? 'active-page' : ''}" data-page="${i}">${i}</button>`;
            else if (i === activePage - 2 || i === activePage + 2)
                html += `<span style="color:var(--muted);padding:0 4px;">...</span>`;
        }
        html += `<button class="page-next" ${activePage === totalPages ? 'disabled' : ''}>Siguiente ›</button>`;
        paginationDiv.innerHTML = html;
        document.querySelector('.page-prev')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; applyFiltersAndRender(); } });
        document.querySelector('.page-next')?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; applyFiltersAndRender(); } });
        document.querySelectorAll('.page-num').forEach(btn => btn.addEventListener('click', () => { currentPage = parseInt(btn.dataset.page); applyFiltersAndRender(); }));
    }

    async function crearTag() {
        const profileType = profileTypeSelect.value;
        const tag = tagInput.value.trim();
        const password = passwordInput.value;
        if (!profileType) { showFeedback('Seleccioná un tipo.', true); return; }
        if (!tag) { showFeedback('Ingresá el número de tag.', true); return; }
        if (!password || password.length < 6) { showFeedback('La contraseña debe tener al menos 6 caracteres.', true); return; }
        btnCreate.disabled = true; btnCreate.textContent = 'Creando...';
        try {
            const res = await fetch('/superadmin/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tag, password, role: ROLE_MAP[profileType], profileType }) });
            const data = await res.json();
            if (!res.ok) { showFeedback(data.message || 'Error al crear.', true); }
            else {
                showFeedback(`✓ Tag #${tag} creado.`, false);
                tagInput.value = ''; passwordInput.value = ''; profileTypeSelect.value = ''; roleHidden.value = '';
                currentPage = 1;
                await fetchAllUsers();
            }
        } catch { showFeedback('Error de conexión.', true); }
        finally { btnCreate.disabled = false; btnCreate.textContent = 'Crear tag'; }
    }

    async function eliminarTag(tag, btn) {
        if (!confirm(`¿Eliminar el tag #${tag}? No se puede deshacer.`)) return;
        if (btn) btn.disabled = true;
        try {
            const res = await fetch(`/superadmin/tag/${tag}`, { method: 'DELETE' });
            const data = await res.json();
            if (res.ok) { showFeedback(`Tag #${tag} eliminado.`, false); currentPage = 1; await fetchAllUsers(); }
            else { showFeedback(data.message || 'Error al eliminar.', true); if (btn) btn.disabled = false; }
        } catch { showFeedback('Error de conexión.', true); if (btn) btn.disabled = false; }
    }

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter;
            currentPage = 1;
            applyFiltersAndRender();
        });
    });

    profileTypeSelect.addEventListener('change', () => { roleHidden.value = ROLE_MAP[profileTypeSelect.value] || ''; });
    btnCreate.addEventListener('click', crearTag);
    nextTagBtn.addEventListener('click', fillNextTag);

    fetchAllUsers().then(() => { if (!tagInput.value) fillNextTag(); });
</script>
</body>
</html>
