<style>
  .containerAdmin { display: flex; flex-direction: column; align-items: center; }
  .productsAdmin { display: flex; flex-wrap: wrap; justify-content: center; }
  .card { margin: 10px; width: 420px; }
  .footer { text-align: center; margin-top: 20px; }
  .title-container { background-color: #f0f0f0; padding: 20px; border-radius: 10px; margin-bottom: 20px; text-align: center; width: 80%; }
  .title-container h1 { margin: 0; font-size: 24px; color: #333; }
  .card-footer { display: flex; flex-direction: column; align-items: stretch; }
  .card-footer button, .card-footer a { width: 100%; margin-top: 5px; }
  .check-label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #555; white-space: nowrap; cursor: pointer; margin-top: 4px; }
</style>

<br />
<div class="containerAdmin">
  <div class="title-container">
    <h1>Tu número de tag es {{user.tag}}.<br />
      Completá tu perfil y configurá tu correo de recuperación.</h1>
  </div>

  <h3>Mi perfil:</h3>

  <div class="productsAdmin">
    {{#each allProducts}}
      <div class="card">
        <div class="card-body">
          <form class="form" role="form" autocomplete="off" id="formProductAdmin">
            <input class="form-control" type="hidden" name="productId" value="{{_id}}" />

            <label>Tag:</label>
            <input class="form-control" type="text" value="{{tag}}" readonly />

            <label>Email (privado — para recuperar tu contraseña):</label>
            <input id="newEmail-{{_id}}" class="form-control" type="email" name="email" value="{{email}}" />
            <label class="check-label">
              <input id="newMostrarEmail-{{_id}}" type="checkbox" name="mostrarEmail" {{#if mostrarEmail}}checked{{/if}} />
              Mostrar email en mi página pública
            </label>

            <label>Nombre:</label>
            <input id="newTitle-{{_id}}" class="form-control" type="text" name="title" value="{{title}}" />

            <label>URL de la foto:</label>
            <input id="newThumbnail-{{_id}}" class="form-control" type="text" name="thumbnail" value="{{thumbnail}}" />

            <label>Descripción / Sobre mí:</label>
            <input id="newDescription-{{_id}}" class="form-control" type="text" name="description" value="{{description}}" />

            <label>Fecha de nacimiento:</label>
            <input id="newFechadenacimiento-{{_id}}" class="form-control" type="text" name="fechadenacimiento" value="{{fechadenacimiento}}" />

            <label>Contacto de referencia:</label>
            <input id="newNombredelhumano-{{_id}}" class="form-control" type="text" name="nombredelhumano" value="{{nombredelhumano}}" />

            <label>Teléfono:</label>
            <input id="newTelefono-{{_id}}" class="form-control" type="text" name="telefono" value="{{telefono}}" />
          </form>
        </div>
        <div class="card-footer">
          <button type="button" class="btn btn-outline-success" onclick="updateProduct('{{_id}}')">Guardar cambios</button>
          <a href="api/products/{{this._id}}" class="btn btn-primary">Ver página pública</a>
        </div>
      </div>
    {{/each}}
  </div>
</div>

<div class="footer">
  Desarrollado por <a href="https://lauroware.github.io/portfolio/" target="_blank">Lauro Ware</a><br />
  Sitio de nuestra empresa: <a href="https://www.totinas.com.ar">Totinas</a>
</div>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/adminView2.js"></script>
