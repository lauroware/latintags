<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Panel de Administración | Totinas</title>
    <!-- Google Fonts + Font Awesome Icons for a premium look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Bootstrap 5 (lightweight, but we'll override heavily to match modern design) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom polished styles -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(145deg, #f4f7fc 0%, #eef2f5 100%);
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            padding: 2rem 1rem;
            color: #1e293b;
        }

        /* smooth scroll & focus */
        html {
            scroll-behavior: smooth;
        }

        /* main container */
        .containerAdmin {
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        /* ----- TITLE CARD (hero) ----- */
        .title-container {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(2px);
            border-radius: 2rem;
            padding: 2rem 2rem;
            margin-bottom: 2.5rem;
            text-align: center;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.6);
            transition: all 0.2s ease;
        }

        .title-container h1 {
            font-size: 1.9rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1f2b48, #2c3e66);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            margin: 0;
            letter-spacing: -0.3px;
        }

        .title-container h1 br {
            display: none;
        }

        .tag-badge {
            display: inline-block;
            background: linear-gradient(105deg, #2b3b5c, #1f2f4a);
            color: white;
            font-weight: 600;
            padding: 0.2rem 1rem;
            border-radius: 60px;
            font-size: 1.2rem;
            margin: 0 0.2rem;
            box-shadow: inset 0 1px 1px rgba(255,255,255,0.2), 0 4px 8px rgba(0,0,0,0.05);
        }

        @media (min-width: 768px) {
            .title-container h1 br {
                display: inline;
            }
        }

        /* section header (Mi mascota) */
        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-bottom: 1.8rem;
            margin-top: 0.5rem;
        }
        .section-header h3 {
            font-weight: 700;
            font-size: 1.8rem;
            color: #0f172a;
            letter-spacing: -0.3px;
            background: linear-gradient(120deg, #1e293b, #334155);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            border-left: 5px solid #3b82f6;
            padding-left: 1rem;
        }
        .pets-count {
            background: #e9eef3;
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.85rem;
            font-weight: 500;
            color: #1e40af;
        }

        /* GRID DE CARDS (modern responsive) */
        .productsAdmin {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
            gap: 2rem;
            margin-top: 0.5rem;
        }

        /* CARD premium */
        .card {
            background: #ffffff;
            border: none;
            border-radius: 2rem;
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.3s ease;
            box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.01);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 24px 40px -12px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(59,130,246,0.1);
        }

        .card-body {
            padding: 1.6rem 1.8rem;
        }

        /* FORM INSIDE CARD: modern grid layout 2 columns */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.2rem 1.5rem;
        }

        .full-width {
            grid-column: span 2;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .field-group label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #5b6e8c;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .field-group label i {
            font-size: 0.8rem;
            width: 1.1rem;
            color: #3b82f6;
        }

        .form-control, input.form-control {
            background-color: #f9fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 1rem;
            padding: 0.7rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            color: #0f172a;
        }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.15);
            background-color: white;
            outline: none;
        }

        /* read-only tag field (special style) */
        input[readonly].form-control {
            background: #f1f5f9;
            border-color: #d1dbe8;
            color: #2c3e66;
            font-weight: 600;
            font-family: monospace;
            font-size: 0.9rem;
        }

        /* checkbox row (mostrar email) */
        .check-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #f8fafc;
            padding: 0.5rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 0.2rem;
            width: fit-content;
        }
        .check-label:hover {
            background: #eef2ff;
        }
        .check-label input {
            width: 1rem;
            height: 1rem;
            accent-color: #3b82f6;
            cursor: pointer;
        }

        /* card-footer buttons */
        .card-footer {
            background: #ffffff;
            border-top: 1px solid #edf2f7;
            padding: 1.2rem 1.8rem 1.6rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .btn {
            border-radius: 2rem;
            padding: 0.7rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.3px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
        }

        .btn-outline-success {
            background: linear-gradient(105deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 8px rgba(16,185,129,0.2);
        }
        .btn-outline-success:hover {
            transform: scale(0.98);
            background: linear-gradient(105deg, #059669, #047857);
            box-shadow: 0 6px 12px rgba(5,150,105,0.25);
        }

        .btn-primary {
            background: linear-gradient(115deg, #3b82f6, #2563eb);
            color: white;
            box-shadow: 0 4px 8px rgba(59,130,246,0.2);
        }
        .btn-primary:hover {
            background: linear-gradient(115deg, #2563eb, #1d4ed8);
            transform: translateY(-1px);
        }

        /* footer profesional */
        .footer {
            margin-top: 4rem;
            text-align: center;
            padding: 2rem 1rem 1rem;
            border-top: 1px solid #e2e8f0;
            font-size: 0.85rem;
            color: #4b5565;
        }
        .footer a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }
        .footer a:hover {
            color: #1e3a8a;
            text-decoration: underline;
        }

        /* responsive improvements */
        @media (max-width: 640px) {
            .productsAdmin {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            .form-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            .full-width {
                grid-column: span 1;
            }
            .card-body {
                padding: 1.2rem;
            }
            .title-container h1 {
                font-size: 1.3rem;
            }
            .section-header h3 {
                font-size: 1.4rem;
            }
        }

        /* small utilities */
        .text-muted-helper {
            font-size: 0.7rem;
            color: #6c86a3;
            margin-top: 0.2rem;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        i.fa, i.far, i.fas {
            pointer-events: none;
        }
        .btn i {
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

<div class="containerAdmin">
    <!-- Hero con número de tag mejorado -->
    <div class="title-container">
        <h1>
            Tu número de tag es <span class="tag-badge">{{user.tag}}</span><br />
            Completá el perfil de tu mascota y configurá tu correo de recuperación
        </h1>
        <p style="margin-top: 0.8rem; color: #475569; font-size: 0.9rem; font-weight: 400;">
            <i class="fas fa-shield-alt"></i> Los datos médicos y contacto son privados, solo el email de recuperación es esencial
        </p>
    </div>

    <div class="section-header">
        <h3><i class="fas fa-paw me-2"></i> Mis compañeros</h3>
        <div class="pets-count">
            <i class="fas fa-dog"></i> {{#if allProducts}}{{allProducts.length}}{{else}}0{{/if}} registros
        </div>
    </div>

    <div class="productsAdmin">
        {{#each allProducts}}
            <div class="card">
                <div class="card-body">
                    <form class="form" role="form" autocomplete="off" id="formProductAdmin">
                        <input class="form-control" type="hidden" name="productId" value="{{_id}}" />

                        <!-- grid profesional 2 columnas -->
                        <div class="form-grid">
                            <!-- Tag (readonly) -->
                            <div class="field-group">
                                <label><i class="fas fa-qrcode"></i> TAG (ID único)</label>
                                <input class="form-control" type="text" value="{{tag}}" readonly />
                            </div>

                            <!-- Email privado -->
                            <div class="field-group">
                                <label><i class="fas fa-envelope"></i> Email recuperación</label>
                                <input id="newEmail-{{_id}}" class="form-control" type="email" name="email" value="{{email}}" placeholder="ejemplo@totinas.com" />
                                <div class="text-muted-helper">
                                    <i class="fas fa-lock"></i> solo para recuperar contraseña
                                </div>
                            </div>

                            <!-- Mostrar email en pública (checkbox estilizado) -->
                            <div class="field-group full-width">
                                <label class="check-label">
                                    <input id="newMostrarEmail-{{_id}}" type="checkbox" name="mostrarEmail" {{#if mostrarEmail}}checked{{/if}} />
                                    <i class="fas fa-globe"></i> Mostrar email en mi página pública
                                </label>
                            </div>

                            <!-- Nombre mascota -->
                            <div class="field-group">
                                <label><i class="fas fa-tag"></i> Nombre mascota</label>
                                <input id="newTitle-{{_id}}" class="form-control" type="text" name="title" value="{{title}}" placeholder="Ej: Rocky" />
                            </div>

                            <!-- URL Foto -->
                            <div class="field-group">
                                <label><i class="fas fa-image"></i> URL de la foto</label>
                                <input id="newThumbnail-{{_id}}" class="form-control" type="text" name="thumbnail" value="{{thumbnail}}" placeholder="https://..." />
                            </div>

                            <!-- Descripción -->
                            <div class="field-group full-width">
                                <label><i class="fas fa-align-left"></i> Descripción / personalidad</label>
                                <input id="newDescription-{{_id}}" class="form-control" type="text" name="description" value="{{description}}" placeholder="Ej: Le gusta jugar con la pelota, muy cariñoso" />
                            </div>

                            <!-- Fecha nacimiento -->
                            <div class="field-group">
                                <label><i class="fas fa-cake-candles"></i> Fecha nacimiento</label>
                                <input id="newFechadenacimiento-{{_id}}" class="form-control" type="text" name="fechadenacimiento" value="{{fechadenacimiento}}" placeholder="DD/MM/AAAA" />
                            </div>

                            <!-- Medicamentos -->
                            <div class="field-group">
                                <label><i class="fas fa-capsules"></i> Medicamentos</label>
                                <input id="newMedicamentos-{{_id}}" class="form-control" type="text" name="medicamentos" value="{{medicamentos}}" placeholder="Indicar dosis y frecuencia" />
                            </div>

                            <!-- Historia clínica -->
                            <div class="field-group full-width">
                                <label><i class="fas fa-notes-medical"></i> Historia clínica / enfermedades</label>
                                <input id="newEnfermedades-{{_id}}" class="form-control" type="text" name="enfermedades" value="{{enfermedades}}" placeholder="Alergias, cirugías, condiciones crónicas" />
                            </div>

                            <!-- Nombre del humano -->
                            <div class="field-group">
                                <label><i class="fas fa-user-check"></i> Nombre del tutor</label>
                                <input id="newNombredelhumano-{{_id}}" class="form-control" type="text" name="nombredelhumano" value="{{nombredelhumano}}" placeholder="Tu nombre completo" />
                            </div>

                            <!-- Teléfono -->
                            <div class="field-group">
                                <label><i class="fas fa-phone-alt"></i> Teléfono de contacto</label>
                                <input id="newTelefono-{{_id}}" class="form-control" type="text" name="telefono" value="{{telefono}}" placeholder="+54 11 1234-5678" />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-outline-success" onclick="updateProduct('{{_id}}')">
                        <i class="fas fa-save"></i> Guardar cambios
                    </button>
                    <a href="api/products/{{this._id}}" class="btn btn-primary">
                        <i class="fas fa-external-link-alt"></i> Ver página pública
                    </a>
                </div>
            </div>
        {{/each}}
    </div>
</div>

<div class="footer">
    <i class="fas fa-code-branch"></i> Desarrollado por <a href="https://lauroware.github.io/portfolio/" target="_blank">Lauro Ware</a><br />
    <i class="fas fa-store"></i> Sitio de nuestra empresa: <a href="https://www.totinas.com.ar" target="_blank">Totinas</a> — Cuidado y tecnología para tu mascota
</div>

<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/adminView.js"></script>

<!-- Aseguramos que la función updateProduct exista sin errores adicionales (el archivo adminView.js ya la define) 
     Pero agregamos micro mejora: si no existe la función, no rompe -->
<script>
    (function() {
        if (typeof updateProduct !== 'function') {
            console.warn("updateProduct no está definida, verifica que adminView.js se cargue correctamente");
            window.updateProduct = function(id) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error de configuración',
                    text: 'No se pudo actualizar, recarga la página o contacta soporte.',
                    confirmButtonColor: '#3b82f6'
                });
            };
        }
    })();
</script>

<!--
    NOTA: Los estilos mejorados respetan todas las funcionalidades existentes:
    - Los campos mantienen los mismos IDs y nombres para que adminView.js funcione correctamente.
    - Se añadió una cuadrícula moderna (2 columnas) en cada tarjeta para aprovechar espacio.
    - La visual es completamente profesional: sombras, tipografía, botones con gradiente, transiciones suaves.
    - Se agregaron iconos intuitivos sin perder rendimiento.
    - Totalmente responsivo: en móvil las tarjetas y columnas se adaptan.
-->
</body>
</html>