<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <title>Panel de Control | Nexo Tags</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <style>
    :root { --bg:#0b0f14; --panel:rgba(255,255,255,0.06); --panelBorder:rgba(255,255,255,0.12); --text:rgba(255,255,255,0.92); --muted:rgba(255,255,255,0.68); --accent:#00a7c4; --cardBg:rgba(18,24,32,0.7); --shadow:0 25px 45px -12px rgba(0,0,0,0.6); --radius:24px; --radiusCard:20px; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:radial-gradient(900px 600px at 20% 10%,rgba(0,167,196,0.2),transparent 60%),radial-gradient(800px 600px at 85% 80%,rgba(8,179,213,0.18),transparent 55%),linear-gradient(145deg,#0b0f14 0%,#05080c 100%); font-family:'Inter',system-ui,sans-serif; color:var(--text); min-height:100vh; padding:2rem 1rem; position:relative; }
    body::before { content:""; position:fixed; inset:0; pointer-events:none; background-image:linear-gradient(rgba(255,255,255,0.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.035) 1px,transparent 1px); background-size:48px 48px; z-index:0; }
    .containerAdmin { position:relative; z-index:2; max-width:1400px; margin:0 auto; width:100%; display:flex; flex-direction:column; align-items:center; }
    .title-container { width:100%; max-width:880px; margin:0 auto 2.5rem; background:var(--panel); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid var(--panelBorder); border-radius:var(--radius); padding:2rem 1.8rem; text-align:center; box-shadow:var(--shadow); }
    .title-container h1 { font-size:clamp(1.4rem,4vw,1.9rem); font-weight:700; background:linear-gradient(125deg,#fff,#b0f0ff); background-clip:text; -webkit-background-clip:text; color:transparent; }
    .tag-highlight { display:inline-block; background:linear-gradient(105deg,#00a7c4,#1bcedb); padding:0.2rem 1rem; border-radius:60px; font-size:1.2rem; font-weight:800; color:#01161e; box-shadow:0 0 12px rgba(0,167,196,0.5); margin:0 0.15rem; }
    .sub-message { margin-top:1rem; font-size:0.85rem; color:var(--muted); display:flex; align-items:center; justify-content:center; gap:0.5rem; }
    .section-header { width:100%; display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; margin:1rem 0 1.8rem; }
    .section-header h3 { font-weight:700; font-size:1.7rem; background:linear-gradient(115deg,#eef2ff,#b2f0ff); background-clip:text; -webkit-background-clip:text; color:transparent; border-left:4px solid var(--accent); padding-left:1rem; }
    .pets-count { background:rgba(0,167,196,0.18); padding:0.4rem 1rem; border-radius:40px; font-size:0.75rem; font-weight:500; color:#adeeff; border:1px solid rgba(0,167,196,0.3); }
    .productsAdmin { display:grid; grid-template-columns:repeat(auto-fill,minmax(520px,1fr)); gap:2rem; width:100%; justify-items:center; align-items:start; }
    .card { background:var(--cardBg); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radiusCard); width:100%; transition:transform 0.2s,box-shadow 0.25s; box-shadow:0 15px 35px -12px rgba(0,0,0,0.4); overflow:hidden; }
    .card:hover { transform:translateY(-4px); border-color:rgba(0,167,196,0.4); }
    .card-body { padding:1.6rem 1.8rem; }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem 1.6rem; }
    .full-width { grid-column:span 2; }
    .field-group { display:flex; flex-direction:column; gap:0.35rem; }
    .field-group label { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#b3d9ff; display:flex; align-items:center; gap:6px; }
    .field-group label i { font-size:0.75rem; color:var(--accent); }
    .form-control { background:rgba(10,14,23,0.7); border:1.2px solid rgba(255,255,255,0.12); border-radius:16px; padding:0.7rem 1rem; font-size:0.85rem; font-weight:500; color:#f0f3fa; transition:all 0.2s; width:100%; }
    .form-control:focus { outline:none; border-color:var(--accent); background:rgba(10,14,23,0.9); box-shadow:0 0 0 3px rgba(0,167,196,0.3); }
    input[readonly].form-control { background:rgba(0,0,0,0.35); color:#bbdef5; font-family:monospace; border-color:rgba(0,167,196,0.3); }
    .check-label { display:inline-flex; align-items:center; gap:8px; background:rgba(0,167,196,0.1); padding:0.45rem 1rem; border-radius:40px; font-size:0.75rem; font-weight:600; color:#caf0ff; cursor:pointer; transition:all 0.2s; border:1px solid rgba(0,167,196,0.2); }
    .check-label:hover { background:rgba(0,167,196,0.22); }
    .check-label input { width:1rem; height:1rem; accent-color:var(--accent); margin:0; }
    .upload-row { display:flex; gap:8px; align-items:center; }
    .upload-row input.form-control { flex:1; }
    .btn-upload { background:rgba(0,167,196,0.15); border:1px solid rgba(0,167,196,0.35); color:#caf0ff; border-radius:40px; padding:0.5rem 1rem; font-size:0.75rem; font-weight:600; cursor:pointer; white-space:nowrap; transition:all 0.2s; }
    .btn-upload:hover { background:rgba(0,167,196,0.28); }
    .upload-status { font-size:0.65rem; color:var(--muted); margin-top:3px; }
    .card-footer { background:rgba(0,0,0,0.25); border-top:1px solid rgba(255,255,255,0.08); padding:1.2rem 1.8rem 1.6rem; display:flex; flex-direction:column; gap:0.75rem; }
    .btn { border-radius:40px; padding:0.7rem 1rem; font-weight:700; font-size:0.85rem; transition:all 0.2s; display:inline-flex; align-items:center; justify-content:center; gap:10px; border:none; }
    .btn-outline-success { background:linear-gradient(105deg,#0f766e,#0d9488); color:white; box-shadow:0 4px 12px rgba(13,148,136,0.3); }
    .btn-primary { background:linear-gradient(115deg,#1e3a5f,#0f2c48); color:#e2f0ff; border:1px solid rgba(0,167,196,0.4); }
    .btn-primary:hover { background:linear-gradient(115deg,#2c4c74,#153653); color:white; }
    .text-helper { font-size:0.65rem; color:var(--muted); display:flex; align-items:center; gap:4px; margin-top:4px; }
    .footer { position:relative; z-index:2; margin-top:4rem; text-align:center; font-size:0.75rem; color:rgba(255,255,255,0.5); padding:1.5rem 1rem; border-top:1px solid rgba(255,255,255,0.08); }
    .footer a { color:#86e0f0; text-decoration:none; font-weight:600; }
    @media(max-width:680px) { .productsAdmin { grid-template-columns:1fr; } .form-grid { grid-template-columns:1fr; } .full-width { grid-column:span 1; } .card-body { padding:1.2rem; } }
  </style>
</head>
<body>

  <!-- Navbar Nexo -->
  <nav style="position:relative;z-index:10;background:rgba(0,0,0,0.45);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.08);padding:0.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
    <a href="/api/products" style="color:#00a7c4;font-weight:700;font-size:0.95rem;text-decoration:none;display:flex;align-items:center;gap:6px;"><i class="fas fa-home"></i> Inicio</a>
    <a href="/auth/logout" style="color:rgba(255,255,255,0.7);font-size:0.85rem;text-decoration:none;display:flex;align-items:center;gap:6px;"><i class="fas fa-sign-out-alt"></i> Cerrar sesión</a>
  </nav>

<div class="containerAdmin">
  <div class="title-container">
    <h1><i class="fas fa-tag"></i> Tu número de tag es <span class="tag-highlight">{{user.tag}}</span><br />Completá el perfil y configurá tu correo de recuperación</h1>
    <div class="sub-message"><i class="fas fa-shield-alt"></i> Solo el email es clave para recuperar tu cuenta</div>
  </div>

  <div class="section-header">
    <h3><i class="fas fa-box me-2"></i> Mi objeto</h3>
    <div class="pets-count"><i class="fas fa-tag"></i> {{#if allProducts}}{{allProducts.length}}{{else}}0{{/if}} registros</div>
  </div>

  <div class="productsAdmin">
    {{#each allProducts}}
      <div class="card">
        <div class="card-body">
          <form class="form" role="form" autocomplete="off">
            <input type="hidden" name="productId" value="{{_id}}" />
            <div class="form-grid">

              <div class="field-group">
                <label><i class="fas fa-qrcode"></i> Tag</label>
                <input class="form-control" type="text" value="{{tag}}" readonly />
              </div>

              <div class="field-group">
                <label><i class="fas fa-envelope"></i> Email recuperación</label>
                <input id="newEmail-{{_id}}" class="form-control" type="email" name="email" value="{{email}}" placeholder="micorreo@ejemplo.com" />
                <div class="text-helper"><i class="fas fa-lock"></i> Solo para recuperar tu contraseña.</div>
              </div>

              <div class="field-group full-width">
                <label class="check-label">
                  <input id="newMostrarEmail-{{_id}}" type="checkbox" name="mostrarEmail" {{#if mostrarEmail}}checked{{/if}} />
                  <i class="fas fa-globe"></i> Mostrar email en mi página pública
                </label>
              </div>

              <div class="field-group">
                <label><i class="fas fa-box"></i> Nombre del objeto</label>
                <input id="newTitle-{{_id}}" class="form-control" type="text" name="title" value="{{title}}" placeholder="Ej: Mochila negra" />
              </div>

              <div class="field-group">
                <label><i class="fas fa-image"></i> Foto</label>
                <div class="upload-row">
                  <input id="newThumbnail-{{_id}}" class="form-control" type="text" name="thumbnail" value="{{thumbnail}}" placeholder="URL o subí una foto" />
                  <label class="btn-upload">
                    <i class="fas fa-upload"></i> Subir
                    <input type="file" accept="image/*" style="display:none" onchange="uploadFoto(this,'{{_id}}')" />
                  </label>
                </div>
                <small id="uploadStatus-{{_id}}" class="upload-status"></small>
              </div>

              <div class="field-group full-width">
                <label><i class="fas fa-align-left"></i> Descripción</label>
                <input id="newDescription-{{_id}}" class="form-control" type="text" name="description" value="{{description}}" placeholder="Color, características, valor sentimental..." />
              </div>

              <div class="field-group">
                <label><i class="fas fa-user-check"></i> Nombre de contacto</label>
                <input id="newNombredelhumano-{{_id}}" class="form-control" type="text" name="nombredelhumano" value="{{nombredelhumano}}" placeholder="Tu nombre completo" />
              </div>

              <div class="field-group">
                <label><i class="fas fa-phone-alt"></i> Teléfono de contacto</label>
                <input id="newTelefono-{{_id}}" class="form-control" type="text" name="telefono" value="{{telefono}}" placeholder="+54 9 11 1234-5678" />
              </div>


              <!-- Modo perdido -->
              <div class="field-group full-width" style="border:1px solid rgba(255,80,80,0.3);border-radius:16px;padding:1rem;background:rgba(255,40,40,0.06);">
                <label style="color:#ff8080;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.5rem;display:flex;align-items:center;gap:6px;"><i class="fas fa-exclamation-triangle"></i> Modo perdido</label>
                <input id="newMensajePerdido-{{_id}}" class="form-control" type="text" name="mensajePerdido" value="{{mensajePerdido}}" placeholder="Mensaje opcional (ej: Si lo encontraste llamame al...)" style="margin-bottom:0.75rem;" />
                {{#if modoPerdido}}
                  <button type="button" onclick="togglePerdido('{{_id}}', false)" style="background:rgba(255,80,80,0.2);border:1px solid rgba(255,80,80,0.5);color:#ff8080;border-radius:40px;padding:0.5rem 1.2rem;font-size:0.8rem;font-weight:700;cursor:pointer;width:100%;">
                    <i class="fas fa-check-circle"></i> Desactivar modo perdido
                  </button>
                {{else}}
                  <button type="button" onclick="togglePerdido('{{_id}}', true)" style="background:rgba(255,80,80,0.15);border:1px solid rgba(255,80,80,0.4);color:#ffaaaa;border-radius:40px;padding:0.5rem 1.2rem;font-size:0.8rem;font-weight:700;cursor:pointer;width:100%;">
                    <i class="fas fa-exclamation-circle"></i> Activar modo perdido
                  </button>
                {{/if}}
              </div>

            </div>
          </form>
        </div>
        <div class="card-footer">
          <button type="button" class="btn btn-outline-success" onclick="updateProduct('{{_id}}')">
            <i class="fas fa-save"></i> Guardar cambios
          </button>
          <a href="/api/products/{{this._id}}" class="btn btn-primary">
            <i class="fas fa-external-link-alt"></i> Ver página pública
          </a>
        </div>
      </div>
    {{/each}}
  </div>
</div>

<div class="footer">
  <i class="fas fa-code-branch"></i> Desarrollado por <a href="https://lauroware.github.io/portfolio/" target="_blank">Lauro Ware</a> &nbsp;|&nbsp;
  <i class="fas fa-store"></i> <a href="https://www.totinas.com.ar" target="_blank">Totinas</a>
</div>

<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/adminView1.js"></script>
</body>
</html>
