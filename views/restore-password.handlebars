<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña | Nexo Tags</title>

    <!-- Fuente -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #0b0f14;
        --panel: rgba(255, 255, 255, 0.08);
        --panelBorder: rgba(255, 255, 255, 0.14);
        --text: rgba(255, 255, 255, 0.92);
        --muted: rgba(255, 255, 255, 0.65);
        --accent: #00a7c4;
        --accent2: #08b3d5;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
        --radius: 18px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial,
          sans-serif;
        color: var(--text);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: radial-gradient(
            900px 600px at 20% 10%,
            rgba(0, 167, 196, 0.22),
            transparent 60%
          ),
          radial-gradient(
            700px 500px at 90% 70%,
            rgba(8, 179, 213, 0.18),
            transparent 55%
          ),
          linear-gradient(180deg, #0b0f14, #070a0f);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            rgba(255, 255, 255, 0.06) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.06) 1px,
            transparent 1px
          );
        background-size: 44px 44px;
        opacity: 0.12;
      }

      .containerAuth {
        width: 100%;
        max-width: 520px;
        padding: 22px 22px 18px;
        background: var(--panel);
        border: 1px solid var(--panelBorder);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        position: relative;
        overflow: hidden;
      }

      .containerAuth::after {
        content: "";
        position: absolute;
        inset: -2px;
        background: linear-gradient(
          135deg,
          rgba(0, 167, 196, 0.35),
          transparent 40%,
          rgba(8, 179, 213, 0.25)
        );
        filter: blur(18px);
        opacity: 0.55;
        pointer-events: none;
      }

      .inner {
        position: relative;
        z-index: 1;
      }

      /* Logo franja */
      .brand-wide {
        width: calc(100% + 44px);
        margin: -22px -22px 16px;
        display: flex;
        justify-content: center;
      }

      .brand-wide img {
        width: 100%;
        height: auto;
        max-height: 80px;
        object-fit: contain;
        display: block;
      }

      h1 {
        margin: 6px 0 6px;
        font-size: 20px;
        text-align: center;
        letter-spacing: 0.2px;
      }

      .subtitle {
        margin: 0 0 16px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
      }

      .card {
        background: rgba(0, 0, 0, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        padding: 14px;
        margin: 0 0 12px;
      }

      .card h2 {
        margin: 0 0 10px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.88);
        font-weight: 700;
        letter-spacing: 0.2px;
      }

      .form-group {
        margin-bottom: 12px;
      }

      label {
        display: block;
        font-size: 12px;
        color: var(--muted);
        margin: 0 0 6px;
      }

      .form-control {
        width: 100%;
        padding: 12px 12px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.28);
        color: var(--text);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .form-control::placeholder {
        color: rgba(255, 255, 255, 0.45);
      }

      .form-control:focus {
        border-color: rgba(0, 167, 196, 0.8);
        box-shadow: 0 0 0 4px rgba(0, 167, 196, 0.18);
      }

      .btn {
        width: 100%;
        padding: 12px 12px;
        border: 0;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 700;
        letter-spacing: 0.2px;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #001018;
        box-shadow: 0 12px 30px rgba(0, 167, 196, 0.22);
        transition: transform 0.08s ease, filter 0.15s ease;
      }

      .btn-primary:hover {
        filter: brightness(1.03);
      }

      .btn-primary:active {
        transform: translateY(1px);
      }

      .actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 14px;
        flex-wrap: wrap;
      }

      .link {
        color: rgba(255, 255, 255, 0.82);
        font-weight: 600;
        text-decoration: none;
        font-size: 13px;
      }

      .link:hover {
        color: #ffffff;
        text-decoration: underline;
        text-decoration-color: rgba(0, 167, 196, 0.75);
        text-underline-offset: 4px;
      }

      /* Mobile: links apilados prolijos */
      @media (max-width: 420px) {
        .actions {
          flex-direction: column;
          align-items: stretch;
        }
        .link {
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <div class="containerAuth">
      <div class="inner">
        <!-- Logo franja -->
        <div class="brand-wide">
          <img
            src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png"
            alt="Nexo Tags"
          />
        </div>

        <h1>¿Olvidaste tu contraseña?</h1>
        <p class="subtitle">
          Ingresá tu número de tag y te mandamos un <b>código</b> al email que tengas registrado.
          Si no lo ves, revisá <b>Spam / Promociones</b>.
        </p>

        <div class="card">
          <h2>1) Pedir código</h2>
          <form id="formRequestCode" autocomplete="off">
            <div class="form-group">
              <label for="tag">Número de tag</label>
              <input
                id="tag"
                name="tag"
                type="text"
                class="form-control"
                placeholder="Ej: 10042"
                required
              />
            </div>
            <button type="submit" class="btn btn-primary">Enviar código</button>
          </form>
        </div>

        <div class="card">
          <h2>2) Cambiar contraseña</h2>
          <form id="formResetPassword" autocomplete="off">
            <div class="form-group">
              <label for="tag2">Número de tag</label>
              <input
                id="tag2"
                name="tag"
                type="text"
                class="form-control"
                placeholder="Ej: 10042"
                required
              />
            </div>
            <div class="form-group">
              <label for="code">Código</label>
              <input
                id="code"
                name="code"
                type="text"
                class="form-control"
                placeholder="Pegá el código que te llegó"
                required
              />
            </div>
            <div class="form-group">
              <label for="newPassword">Nueva contraseña</label>
              <input
                id="newPassword"
                name="newPassword"
                type="password"
                class="form-control"
                placeholder="Nueva contraseña"
                required
              />
            </div>
            <button type="submit" class="btn btn-primary">
              Guardar nueva contraseña
            </button>
          </form>
        </div>

        <div class="actions">
          <a href="/auth/login" class="link">← Volver a iniciar sesión</a>
          <a
            href="https://wa.me/+541162366175"
            target="_blank"
            rel="noreferrer"
            class="link"
            >¿Necesitás ayuda?</a
          >
        </div>
      </div>
    </div>

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/restorePassword.js"></script>
  </body>
</html>
