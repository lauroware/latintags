<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <title>Nexo Tags | Información segura</title>
  
  <!-- Bootstrap 5 (solo utilidades base, no afecta estilos custom) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Google Fonts + Font Awesome 6 (iconos) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <style>
    /* ========== VARIABLES NEXO DARK ========== */
    :root {
      --bg-dark: #0b0f14;
      --panel-glass: rgba(12, 18, 28, 0.75);
      --panel-border: rgba(0, 167, 196, 0.25);
      --text-primary: rgba(255, 255, 255, 0.94);
      --text-muted: rgba(255, 255, 255, 0.68);
      --accent: #00a7c4;
      --accent-glow: rgba(0, 167, 196, 0.35);
      --card-radius: 2rem;
      --shadow-xl: 0 25px 45px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 167, 196, 0.1);
      --transition-smooth: all 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      color: var(--text-primary);
      min-height: 100vh;
      background: radial-gradient(1100px 700px at 10% 15%, rgba(0, 167, 196, 0.2), transparent 65%),
                  radial-gradient(900px 600px at 90% 80%, rgba(8, 179, 213, 0.18), transparent 60%),
                  linear-gradient(145deg, #0b0f14 0%, #03060a 100%);
      position: relative;
    }

    /* grilla de fondo + ruido sutil */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 48px 48px;
      z-index: 0;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at 20% 30%, rgba(0,0,0,0) 0%, rgba(0,0,0,0.25) 100%);
      pointer-events: none;
      z-index: 0;
    }

    /* contenedor principal */
    .containerDetails {
      position: relative;
      z-index: 2;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem 1.5rem;
    }

    /* ========== TARJETA PRINCIPAL (GLASS) ========== */
    .card.tag-card {
      width: min(880px, 100%);
      background: var(--panel-glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--panel-border);
      border-radius: var(--card-radius);
      box-shadow: var(--shadow-xl);
      transition: var(--transition-smooth);
      overflow: hidden;
      position: relative;
    }

    .card.tag-card:hover {
      border-color: rgba(0, 167, 196, 0.45);
      box-shadow: 0 30px 55px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(0, 167, 196, 0.3);
    }

    /* contenido interno */
    .card-body {
      padding: 2rem 2rem 1.8rem;
      position: relative;
      z-index: 1;
    }

    /* imagen destacada (hero) */
    .hero-img {
      width: 100%;
      max-height: 300px;
      object-fit: cover;
      border-radius: 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.45);
      margin-bottom: 1.5rem;
      transition: var(--transition-smooth);
    }

    /* título con gradiente nexo */
    .title {
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(125deg, #ffffff, #b0f0ff, #6ad4e8);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      margin: 0 0 0.5rem 0;
    }

    .subtitle {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 1.8rem;
      border-left: 3px solid var(--accent);
      padding-left: 0.8rem;
      letter-spacing: -0.2px;
    }

    /* grilla de información profesional */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.2rem;
      margin: 1.5rem 0 1.2rem;
    }

    .info-item {
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.2rem;
      padding: 1rem 1.2rem;
      transition: var(--transition-smooth);
    }

    .info-item:hover {
      background: rgba(0, 167, 196, 0.08);
      border-color: rgba(0, 167, 196, 0.3);
      transform: translateY(-2px);
    }

    .info-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #9ab3d5;
      margin-bottom: 0.5rem;
    }

    .info-label i {
      font-size: 0.8rem;
      color: var(--accent);
      width: 1.2rem;
    }

    .info-value {
      margin: 0;
      font-weight: 600;
      font-size: 0.95rem;
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.92);
      word-break: break-word;
    }

    /* enlace tipo WhatsApp */
    .wa-link {
      color: #adeeff;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1.5px dashed rgba(0, 167, 196, 0.6);
      transition: var(--transition-smooth);
    }

    .wa-link:hover {
      color: white;
      border-bottom-color: var(--accent);
    }

    /* nota especial (mascota) */
    .note {
      margin-top: 1.8rem;
      padding: 1rem 1.4rem;
      background: rgba(0, 167, 196, 0.1);
      border-left: 4px solid var(--accent);
      border-radius: 1rem;
      font-size: 0.85rem;
      line-height: 1.5;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .note i {
      font-size: 1.4rem;
      color: var(--accent);
    }

    /* marca / logo */
    .brand-wide {
      margin: 1.8rem -2rem -1.8rem;
      background: rgba(0, 0, 0, 0.35);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1rem;
      text-align: center;
    }

    .brand-wide img {
      max-width: 220px;
      height: auto;
      filter: brightness(0.9) drop-shadow(0 2px 6px rgba(0,0,0,0.3));
      transition: var(--transition-smooth);
    }

    .brand-wide img:hover {
      filter: brightness(1.05);
    }

    /* footer */
    .footer {
      position: relative;
      z-index: 2;
      text-align: center;
      margin-top: 2rem;
      padding: 1.2rem 1rem 2rem;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
    }

    .footer a {
      color: #86e0f0;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }

    .footer a:hover {
      color: white;
      text-decoration: underline;
    }

    /* responsive */
    @media (max-width: 640px) {
      .containerDetails {
        padding: 1.5rem 1rem;
      }
      .card-body {
        padding: 1.4rem;
      }
      .info-grid {
        grid-template-columns: 1fr;
        gap: 0.9rem;
      }
      .hero-img {
        max-height: 220px;
      }
      .note {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    /* imagen por defecto si no hay thumbnail */
    .placeholder-img {
      background: linear-gradient(135deg, #1a2a3a, #0f1a24);
      width: 100%;
      height: 200px;
      border-radius: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      border: 1px dashed rgba(0, 167, 196, 0.4);
      margin-bottom: 1.5rem;
    }
  </style>
</head>
<body>

<div class="containerDetails">
  {{#if isPetFromProducts}}
  <!-- ========== VERSIÓN MASCOTA ========== -->
  <div class="card tag-card">
    <div class="card-body">
      {{#if product.thumbnail}}
        <img src="{{product.thumbnail}}" alt="Foto de {{product.title}}" class="hero-img" />
      {{else}}
        <div class="placeholder-img">
          <i class="fas fa-paw me-2"></i> Foto no disponible
        </div>
      {{/if}}
      <h1 class="title"><i class="fas fa-paw me-2"></i> Hola, soy {{product.title}}</h1>
      <p class="subtitle">Perfil de mascota · datos médicos y contacto de confianza</p>

      <div class="info-grid">
        {{#if product.description}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-align-left"></i> Descripción</div>
          <p class="info-value">{{product.description}}</p>
        </div>
        {{/if}}
        {{#if product.fechadenacimiento}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-cake-candles"></i> Fecha de nacimiento</div>
          <p class="info-value">{{product.fechadenacimiento}}</p>
        </div>
        {{/if}}
        {{#if product.medicamentos}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-capsules"></i> Medicamentos</div>
          <p class="info-value">{{product.medicamentos}}</p>
        </div>
        {{/if}}
        {{#if product.enfermedades}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-notes-medical"></i> Historia clínica</div>
          <p class="info-value">{{product.enfermedades}}</p>
        </div>
        {{/if}}
        {{#if product.nombredelhumano}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-user-check"></i> Nombre del tutor</div>
          <p class="info-value">{{product.nombredelhumano}}</p>
        </div>
        {{/if}}
        {{#if product.telefono}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-phone-alt"></i> Teléfono de contacto</div>
          <p class="info-value">
            <a class="wa-link" href="https://wa.me/{{product.telefono}}" target="_blank" rel="noreferrer">
              <i class="fab fa-whatsapp"></i> {{product.telefono}}
            </a>
          </p>
        </div>
        {{/if}}
        {{#if product.mostrarEmail}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-envelope"></i> Correo electrónico</div>
          <p class="info-value">{{product.email}}</p>
        </div>
        {{/if}}
      </div>

      <div class="note">
        <i class="fas fa-heart"></i>
        <span>Si me encontraste, por favor teneme paciencia. Estaré asustado. ¡Gracias por ayudarme! 🙏</span>
      </div>
      <div class="brand-wide">
        <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
      </div>
    </div>
  </div>

  {{else if isPersonFromProducts}}
  <!-- ========== VERSIÓN PERSONA ========== -->
  <div class="card tag-card">
    <div class="card-body">
      {{#if product.thumbnail}}
        <img src="{{product.thumbnail}}" alt="Foto de {{product.title}}" class="hero-img" />
      {{else}}
        <div class="placeholder-img">
          <i class="fas fa-user-circle me-2"></i> Foto no disponible
        </div>
      {{/if}}
      <h1 class="title"><i class="fas fa-user-astronaut me-2"></i> Hola, soy {{product.title}}</h1>
      <p class="subtitle">Perfil personal · contacto de confianza</p>

      <div class="info-grid">
        {{#if product.description}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-align-left"></i> Sobre mí</div>
          <p class="info-value">{{product.description}}</p>
        </div>
        {{/if}}
        {{#if product.fechadenacimiento}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-cake-candles"></i> Fecha de nacimiento</div>
          <p class="info-value">{{product.fechadenacimiento}}</p>
        </div>
        {{/if}}
        {{#if product.nombredelhumano}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-address-book"></i> Contacto de referencia</div>
          <p class="info-value">{{product.nombredelhumano}}</p>
        </div>
        {{/if}}
        {{#if product.telefono}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-phone-alt"></i> Teléfono</div>
          <p class="info-value">
            <a class="wa-link" href="https://wa.me/{{product.telefono}}" target="_blank" rel="noreferrer">
              <i class="fab fa-whatsapp"></i> {{product.telefono}}
            </a>
          </p>
        </div>
        {{/if}}
        {{#if product.mostrarEmail}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-envelope"></i> Correo electrónico</div>
          <p class="info-value">{{product.email}}</p>
        </div>
        {{/if}}
      </div>

      <div class="brand-wide">
        <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
      </div>
    </div>
  </div>

  {{else}}
  <!-- ========== VERSIÓN OBJETO ========== -->
  <div class="card tag-card">
    <div class="card-body">
      {{#if product.thumbnail}}
        <img src="{{product.thumbnail}}" alt="{{product.title}}" class="hero-img" />
      {{else}}
        <div class="placeholder-img">
          <i class="fas fa-box-open me-2"></i> Imagen no disponible
        </div>
      {{/if}}
      <h1 class="title"><i class="fas fa-tag me-2"></i> {{product.title}}</h1>
      <p class="subtitle">Objeto registrado · datos de devolución rápida</p>

      <div class="info-grid">
        {{#if product.description}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-align-left"></i> Descripción / señas</div>
          <p class="info-value">{{product.description}}</p>
        </div>
        {{/if}}
        {{#if product.nombredelhumano}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-user-check"></i> Nombre de contacto</div>
          <p class="info-value">{{product.nombredelhumano}}</p>
        </div>
        {{/if}}
        {{#if product.telefono}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-phone-alt"></i> Teléfono</div>
          <p class="info-value">
            <a class="wa-link" href="https://wa.me/{{product.telefono}}" target="_blank" rel="noreferrer">
              <i class="fab fa-whatsapp"></i> {{product.telefono}}
            </a>
          </p>
        </div>
        {{/if}}
        {{#if product.mostrarEmail}}
        <div class="info-item">
          <div class="info-label"><i class="fas fa-envelope"></i> Correo electrónico</div>
          <p class="info-value">{{product.email}}</p>
        </div>
        {{/if}}
      </div>

      <div class="brand-wide">
        <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
      </div>
    </div>
  </div>
  {{/if}}
</div>

<div class="footer">
  <i class="fas fa-code-branch"></i> Desarrollado por <a href="https://lauroware.github.io/portfolio/" target="_blank">Lauro Ware</a> &nbsp;|&nbsp;
  <i class="fas fa-store"></i> <a href="https://www.totinas.com.ar" target="_blank">Totinas</a> — Tecnología que conecta
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>