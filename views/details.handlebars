<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Información del tag | Nexo Tags</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --panel: rgba(255,255,255,0.10);
        --panelBorder: rgba(255,255,255,0.16);
        --text: rgba(255,255,255,0.92);
        --muted: rgba(255,255,255,0.70);
        --accent: #00a7c4;
        --shadow: 0 20px 60px rgba(0,0,0,0.55);
        --radius: 18px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        color: var(--text);
        min-height: 100vh;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        {{#if product.modoPerdido}}
          background-image: url('https://p4.wallpaperbetter.com/wallpaper/561/441/224/minimalistic-dark-grey-textures-gradient-2000x1200-abstract-textures-hd-art-wallpaper-preview.jpg');
        {{else if isPetFromProducts}}
          background-image: url('https://media.istockphoto.com/id/1417882544/es/foto/gran-grupo-de-gatos-y-perros-mirando-a-la-c%C3%A1mara-sobre-fondo-azul.jpg?s=612x612&w=0&k=20&c=24s5hhdBTwmBC5wS5fXqdlAJHGBYGoTmO0iY6IQFwWM=');
        {{else if isPersonFromProducts}}
          background-image: url('https://img.freepik.com/free-vector/geometric-background_53876-115958.jpg');
        {{else}}
          background-image: url('https://p4.wallpaperbetter.com/wallpaper/561/441/224/minimalistic-dark-grey-textures-gradient-2000x1200-abstract-textures-hd-art-wallpaper-preview.jpg');
        {{/if}}
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        {{#if product.modoPerdido}}background:
          radial-gradient(900px 600px at 20% 10%, rgba(220,30,30,0.35), transparent 60%),
          radial-gradient(700px 500px at 90% 70%, rgba(180,0,0,0.25), transparent 55%),
          linear-gradient(180deg, rgba(20,0,0,0.75), rgba(10,0,0,0.82));
        {{else}}background:
          radial-gradient(900px 600px at 20% 10%, rgba(0,167,196,0.18), transparent 60%),
          radial-gradient(700px 500px at 90% 70%, rgba(8,179,213,0.14), transparent 55%),
          linear-gradient(180deg, rgba(0,0,0,0.65), rgba(0,0,0,0.72));
        {{/if}}
        pointer-events: none;
      }
      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
        background-size: 44px 44px;
        opacity: 0.10;
      }
      .containerDetails {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 28px 16px;
      }
      .card.tag-card {
        width: min(820px, 100%);
        background: var(--panel);
        border: 1px solid var(--panelBorder);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        overflow: hidden;
        position: relative;
      }
      .card-body { position: relative; z-index: 1; padding: 18px; }
      .hero-img {
        width: 100%; max-height: 260px; object-fit: cover;
        border-radius: 16px; border: 1px solid rgba(255,255,255,0.12);
        box-shadow: 0 16px 40px rgba(0,0,0,0.35); margin-bottom: 14px;
      }
      .title { margin: 0 0 8px; font-size: clamp(22px,3vw,30px); font-weight: 800; }
      .subtitle { margin: 0 0 14px; color: var(--muted); font-size: 13.5px; line-height: 1.45; }
      .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
      .info-item { background: rgba(0,0,0,0.22); border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; padding: 10px 12px; }
      .info-label { display: block; font-size: 11px; color: rgba(255,255,255,0.70); margin-bottom: 4px; }
      .info-value { margin: 0; color: rgba(255,255,255,0.92); font-weight: 700; font-size: 13.5px; word-break: break-word; }
      a.wa-link { color: rgba(255,255,255,0.92); font-weight: 800; text-decoration: none; border-bottom: 1px solid rgba(0,167,196,0.55); }
      a.wa-link:hover { color: #fff; }
      .note { margin-top: 12px; padding: 12px; border-radius: 14px; background: rgba(0,167,196,0.10); border: 1px solid rgba(0,167,196,0.22); font-size: 13px; line-height: 1.45; }
      .brand-wide { width: calc(100% + 36px); margin: 14px -18px -18px; display: flex; justify-content: center; border-top: 1px solid rgba(255,255,255,0.10); background: rgba(0,0,0,0.18); padding: 10px 0; }
      .brand-wide img { width: 100%; max-width: 520px; height: auto; max-height: 64px; object-fit: contain; }
      .footer { position: relative; z-index: 1; text-align: center; margin-top: 18px; padding: 16px 12px 22px; color: rgba(255,255,255,0.6); font-size: 12px; }
      .footer a { color: rgba(255,255,255,0.78); font-weight: 800; text-decoration: none; }
      @media (max-width: 720px) { .info-grid { grid-template-columns: 1fr; } }

      @keyframes pulse-red {
        0%, 100% { box-shadow: 0 0 40px rgba(255,0,0,0.4), 0 0 80px rgba(200,0,0,0.2); }
        50% { box-shadow: 0 0 60px rgba(255,0,0,0.7), 0 0 120px rgba(200,0,0,0.35); }
      }
    </style>
  </head>

  <body>
      <!-- Navbar condicional -->
  {{#if user}}
  <nav style="position:relative;z-index:10;background:rgba(0,0,0,0.45);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.08);padding:0.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;">
    <a href="/api/products" style="color:#00a7c4;font-weight:700;font-size:0.95rem;text-decoration:none;display:flex;align-items:center;gap:6px;"><i class="fas fa-home"></i> Inicio</a>
    <a href="/auth/logout" style="color:rgba(255,255,255,0.7);font-size:0.85rem;text-decoration:none;display:flex;align-items:center;gap:6px;"><i class="fas fa-sign-out-alt"></i> Cerrar sesión</a>
  </nav>
  {{/if}}

      {{#if product.modoPerdido}}
      <div style="position:relative;z-index:2;width:100%;max-width:820px;margin:0 auto 1.5rem;background:linear-gradient(135deg,rgba(200,0,0,0.85),rgba(150,0,0,0.9));border:2px solid rgba(255,80,80,0.7);border-radius:18px;padding:1.5rem;text-align:center;box-shadow:0 0 40px rgba(255,0,0,0.4),0 0 80px rgba(200,0,0,0.2);animation:pulse-red 2s ease-in-out infinite;">
        <div style="font-size:2.5rem;margin-bottom:0.5rem;">🚨</div>
        <h2 style="margin:0 0 0.5rem;font-size:1.8rem;font-weight:800;color:#fff;letter-spacing:2px;text-shadow:0 0 20px rgba(255,100,100,0.8);">¡EXTRAVIADO!</h2>
        {{#if product.perdidoDesde}}
        <p style="margin:0 0 0.5rem;color:rgba(255,200,200,0.9);font-size:0.85rem;">Reportado el {{product.perdidoDesde}}</p>
        {{/if}}
        {{#if product.mensajePerdido}}
        <p style="margin:0.75rem 0 0;color:#fff;font-size:1rem;font-weight:600;background:rgba(0,0,0,0.3);padding:0.75rem 1rem;border-radius:12px;">{{product.mensajePerdido}}</p>
        {{/if}}
      </div>
      {{/if}}

<div class="containerDetails container">

      {{#if isPetFromProducts}}
      <!-- ========== MASCOTA ========== -->
      <div class="card tag-card">
        <div class="card-body">
          {{#if product.thumbnail}}
          <img src="{{product.thumbnail}}" alt="Foto de {{product.title}}" class="hero-img" />
          {{/if}}
          <h1 class="title">Hola, soy {{product.title}}</h1>
          <p class="subtitle">Perfil de mascota — información útil para contacto y cuidado.</p>

          <div class="info-grid">
            {{#if product.description}}
            <div class="info-item">
              <span class="info-label">Descripción</span>
              <p class="info-value">{{product.description}}</p>
            </div>
            {{/if}}
            {{#if product.fechadenacimiento}}
            <div class="info-item">
              <span class="info-label">Fecha de nacimiento</span>
              <p class="info-value">{{product.fechadenacimiento}}</p>
            </div>
            {{/if}}
            {{#if product.medicamentos}}
            <div class="info-item">
              <span class="info-label">Medicamentos</span>
              <p class="info-value">{{product.medicamentos}}</p>
            </div>
            {{/if}}
            {{#if product.enfermedades}}
            <div class="info-item">
              <span class="info-label">Historia clínica</span>
              <p class="info-value">{{product.enfermedades}}</p>
            </div>
            {{/if}}
            {{#if product.nombredelhumano}}
            <div class="info-item">
              <span class="info-label">Nombre de mi humano</span>
              <p class="info-value">{{product.nombredelhumano}}</p>
            </div>
            {{/if}}
            {{#if product.telefono}}
            <div class="info-item">
              <span class="info-label">Teléfono</span>
              <p class="info-value">
                <a class="wa-link" href="https://wa.me/+54{{product.telefono}}" target="_blank" rel="noreferrer">
                  {{product.telefono}}
                </a>
              </p>
            </div>
            {{/if}}
            {{#if product.mostrarEmail}}
            <div class="info-item">
              <span class="info-label">Correo electrónico</span>
              <p class="info-value">{{product.email}}</p>
            </div>
            {{/if}}
          </div>

          <div class="note">
            Si me encontraste, por favor teneme paciencia: voy a estar asustado. Gracias por ayudarme 🙏
          </div>
          <div class="brand-wide">
            <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
          </div>
        </div>
      </div>

      {{else if isPersonFromProducts}}
      <!-- ========== PERSONA ========== -->
      <div class="card tag-card">
        <div class="card-body">
          {{#if product.thumbnail}}
          <img src="{{product.thumbnail}}" alt="Foto de {{product.title}}" class="hero-img" />
          {{/if}}
          <h1 class="title">Hola, soy {{product.title}}</h1>
          <p class="subtitle">Perfil personal — información importante para emergencias y contacto.</p>

          <div class="info-grid">
            {{#if product.description}}
            <div class="info-item">
              <span class="info-label">Sobre mí</span>
              <p class="info-value">{{product.description}}</p>
            </div>
            {{/if}}
            {{#if product.fechadenacimiento}}
            <div class="info-item">
              <span class="info-label">Fecha de nacimiento</span>
              <p class="info-value">{{product.fechadenacimiento}}</p>
            </div>
            {{/if}}
            {{#if product.nombredelhumano}}
            <div class="info-item">
              <span class="info-label">Contacto de referencia</span>
              <p class="info-value">{{product.nombredelhumano}}</p>
            </div>
            {{/if}}
            {{#if product.telefono}}
            <div class="info-item">
              <span class="info-label">Teléfono</span>
              <p class="info-value">
                <a class="wa-link" href="https://wa.me/+54{{product.telefono}}" target="_blank" rel="noreferrer">
                  {{product.telefono}}
                </a>
              </p>
            </div>
            {{/if}}
            {{#if product.mostrarEmail}}
            <div class="info-item">
              <span class="info-label">Correo electrónico</span>
              <p class="info-value">{{product.email}}</p>
            </div>
            {{/if}}
          </div>

          <div class="brand-wide">
            <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
          </div>
        </div>
      </div>

      {{else}}
      <!-- ========== OBJETO ========== -->
      <div class="card tag-card">
        <div class="card-body">
          {{#if product.thumbnail}}
          <img src="{{product.thumbnail}}" alt="{{product.title}}" class="hero-img" />
          {{/if}}
          <h1 class="title">{{product.title}}</h1>
          <p class="subtitle">Información del tag — contacto rápido.</p>

          <div class="info-grid">
            {{#if product.description}}
            <div class="info-item">
              <span class="info-label">Descripción</span>
              <p class="info-value">{{product.description}}</p>
            </div>
            {{/if}}
            {{#if product.nombredelhumano}}
            <div class="info-item">
              <span class="info-label">Nombre de contacto</span>
              <p class="info-value">{{product.nombredelhumano}}</p>
            </div>
            {{/if}}
            {{#if product.telefono}}
            <div class="info-item">
              <span class="info-label">Teléfono</span>
              <p class="info-value">
                <a class="wa-link" href="https://wa.me/+54{{product.telefono}}" target="_blank" rel="noreferrer">
                  {{product.telefono}}
                </a>
              </p>
            </div>
            {{/if}}
            {{#if product.mostrarEmail}}
            <div class="info-item">
              <span class="info-label">Correo electrónico</span>
              <p class="info-value">{{product.email}}</p>
            </div>
            {{/if}}
          </div>

          <div class="brand-wide">
            <img src="https://i.ibb.co/h12X87jS/Sin-t-tulo-2.png" alt="Nexo Tags" />
          </div>
        </div>
      </div>
      {{/if}}

    </div>

    <div class="footer">
      Desarrollado por <a href="https://lauroware.github.io/portfolio/" target="_blank" rel="noreferrer">Lauro Ware</a><br />
      Sitio de nuestra empresa: <a href="https://www.totinas.com.ar" target="_blank" rel="noreferrer">Totinas</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    function compartirPerfil() {
      if (navigator.share) {
        navigator.share({ title: document.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('URL copiada al portapapeles');
      }
    }
    </script>
  </body>
</html>
